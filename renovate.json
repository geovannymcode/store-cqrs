{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies", "java"],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["geovannymcode"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["^org.springframework.boot"],
      "groupName": "spring boot packages"
    },
    {
      "matchPackagePatterns": ["^com.vaadin"],
      "groupName": "vaadin packages"
    }
  ]
}